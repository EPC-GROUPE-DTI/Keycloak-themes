<#--
  Footer of the form column: the company mark that owns the product. Add links here if the deployment
  has them — each needs a real URL, so it ships without placeholders.
-->
<#macro content>
<footer class="gts-footer">
    <img class="gts-corp" src="${url.resourcesPath}/img/gts.png"
         width="241" height="63" alt="${msg("companyName")}" />
</footer>
</#macro>
